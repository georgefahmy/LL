# Copy to .env on your Linux server before running docker compose

# Required for encrypting LearnedLeague session cookies (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
LL_SECRET_KEY=replace-with-a-strong-random-secret-key

# Optional shared passphrase to gate access to https://ll.n890gf.com (leave empty to allow direct access)
LL_ACCESS_CODE=

# Enforce HTTPS on authentication endpoints and Secure cookies in web mode
LL_ENFORCE_HTTPS=true
LL_COOKIE_SECURE=true

# Allowed Host headers (prevents Host header injection; localhost/127.0.0.1 included automatically for healthchecks)
LL_ALLOWED_HOSTS=ll.n890gf.com,localhost,127.0.0.1

# Auth brute-force rate limiting per IP
LL_AUTH_RATE_LIMIT_MAX=10
LL_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Polite rate limit for requests to learnedleague.com (requests per second)
LL_RATE_LIMIT_RPS=2.0

# Background sync check interval for new match days (hours)
LL_SYNC_INTERVAL_HOURS=6

# Authenticated player profile cache TTL (minutes)
LL_PROFILE_CACHE_TTL_MINUTES=30
