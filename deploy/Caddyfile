# Automatic Let's Encrypt HTTPS for ll.n890gf.com (Docker --profile https)
ll.n890gf.com {
    encode zstd gzip

    tls {
        protocols tls1.2 tls1.3
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    reverse_proxy learnedleague:8000
}
