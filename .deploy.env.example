# Copy to .deploy.env (gitignored) and set your Linux server details

# SSH target (e.g. user@192.168.1.50 or SSH config alias like my-linux-box)
DEPLOY_HOST=user@your-linux-server

# Directory on the Linux server where the app and docker-compose.yml live
DEPLOY_DIR=/opt/learnedleague

# SSH port (default 22)
DEPLOY_PORT=22

# Git branch for --git deploys (default main)
DEPLOY_BRANCH=main

# Optional public URL to verify after deploy (clear to skip external check)
DEPLOY_HEALTH_URL=https://ll.n890gf.com/api/health

# Set true to run the built-in Caddy automatic HTTPS container (ports 80/443) via Docker Compose
DEPLOY_USE_CADDY=false
