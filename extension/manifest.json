{
  "manifest_version": 3,
  "name": "LearnedLeague Analytics Bridge",
  "version": "1.0.0",
  "description": "Connects your logged-in learnedleague.com Chrome session to the LearnedLeague Practice Tool & Analytics Suite without sharing passwords or cookies.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.learnedleague.com/*",
    "https://learnedleague.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ll.n890gf.com/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
